[Unit]
Description=Air quality platform - reading consumer (archive, AQI, alerts, persistence)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=airq
Group=airq
WorkingDirectory=/opt/airq/current
EnvironmentFile=/etc/airq/airq.env
Environment=SERVICE_NAME=consumer
ExecStart=/opt/airq/current/.venv/bin/python consumer.py
Restart=always
RestartSec=5
# SIGTERM lets the consumer finish its current batch.
TimeoutStopSec=60
SyslogIdentifier=airq-consumer
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/airq

[Install]
WantedBy=multi-user.target
